# Copy this to .env and fill in your values. Never commit .env.
# After editing .env, recreate the container so it's re-read: docker compose up -d brief-api
ANTHROPIC_API_KEY=sk-ant-...
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox

# Encrypts captured photos/audio at rest. Generate with: openssl rand -base64 32
MEDIA_ENCRYPTION_KEY=

# Optional: route all Claude calls through a corporate gateway (key sent in a custom header).
# SPRING_PROFILES_ACTIVE=gateway
# ANTHROPIC_GATEWAY_URL=https://ai-gateway.example.com/anthropic
# ANTHROPIC_GATEWAY_API_KEY=...
# ANTHROPIC_GATEWAY_KEY_HEADER=X-Gateway-Api-Key

# Optional: override the Claude model per feature (defaults in application.yml: claude-sonnet-5).
# BRIEF_MODEL=claude-sonnet-5
# CHAT_MODEL=claude-sonnet-5
# CAPTURE_MODEL=claude-sonnet-5
# AGENT_MODEL=claude-sonnet-5

# Optional: switch speech-to-text from the local Whisper container to OpenAI.
# TRANSCRIPTION_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Optional: shorten for demos (Spring duration format: 30s, 5m, 48h, 7d)
# CAPTURE_REVIEW_REMINDER=48h
# CAPTURE_RETENTION_NOTES=30d
# CAPTURE_RETENTION_RECORDING=7d
