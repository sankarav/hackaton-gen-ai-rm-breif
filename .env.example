# Copy this to .env and fill in your values. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox

# Encrypts captured photos/audio at rest. Generate with: openssl rand -base64 32
MEDIA_ENCRYPTION_KEY=

# Optional: switch speech-to-text from the local Whisper container to OpenAI.
# TRANSCRIPTION_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Optional: shorten for demos (Spring duration format: 30s, 5m, 48h, 7d)
# CAPTURE_REVIEW_REMINDER=48h
# CAPTURE_RETENTION_NOTES=30d
# CAPTURE_RETENTION_RECORDING=7d
